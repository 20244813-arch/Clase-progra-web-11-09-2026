<!-- views\website\resetpassword.ejs -->
<% layout("layouts/access") %>
    <div class="login-form bg-white bg-opacity-90 p-5 mt-5">

      <!-- Logo -->
      <div class="text-center mb-4">
        <img
          src="/assets/img/ulimaLogo.png"
          width="203"
          height="50"
          alt="Universidad de Lima"
        >
      </div>

      <!-- Título -->
      <div class="text-center mb-4">
        <h4 class="mb-2">Recuperar contraseña</h4>

        <p class="text-muted small mb-0">
          Ingresa tu correo electrónico y te enviaremos
          las instrucciones para recuperar tu contraseña.
        </p>
      </div>

      <!-- Correo -->
      <div class="mb-3">
        <label for="txtEmail" class="form-label">
          Correo electrónico
        </label>

        <input
          class="form-control"
          type="email"
          name="email"
          id="txtEmail"
          placeholder="Ingrese su correo electrónico"
          autocomplete="email"
        >
      </div>

      <!-- Botón -->
      <div class="d-grid mb-3">
        <button type="button" class="btn btn-dark">
          Recuperar contraseña
        </button>
      </div>

      <!-- Regresar al login -->
      <div class="text-center mb-4">
        <a href="/login">
          Regresar al inicio de sesión
        </a>
      </div>

      <!-- Comunicado -->
      <div class="bg-secondary text-white p-3 mb-4">

        <h5 class="mb-3">
          COMUNICADO
        </h5>

        <p class="mb-0 small">
          Estimados usuarios de la comunidad ULima:
          <br><br>

          Para resolver sus consultas sobre las plataformas
          Blackboard y Zoom, ponemos a su disposición los siguientes
          canales de atención:
          <br><br>

          Correo electrónico: soporteaulas@ulima.edu.pe
          <br>
          Teléfono: 01 437 8800
          <br>
          Anexo (en campus): 500
          <br>
          Presencial: Sótano Edificio L2.
          <br>
          Horario: Lunes a viernes 7-22hrs, Sábados 7-13hrs
        </p>

      </div>

      <!-- Copyright -->
      <div class="text-center">
        <small class="text-muted">
          © 1997-2026 Blackboard Inc. Todos los derechos reservados.
        </small>
      </div>

    </div>

  </div>

 
