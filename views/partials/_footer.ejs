<!-- views/partials/_footer.ejs -->

<footer class="bg-dark text-light mt-5">

  <div class="container py-5">

    <div class="row g-4">

      <!-- Columna 1: Marca -->
      <div class="col-12 col-md-6 col-lg">

        <h5 class="fw-bold text-success mb-3">
          PrácticaLima
        </h5>

        <p class="text-white-50 mb-0">
          Bolsa de prácticas pre-profesionales para estudiantes
          de la Universidad de Lima.
        </p>

      </div>


      <!-- Columna 2: Plataforma -->
      <div class="col-6 col-md-6 col-lg">

        <h6 class="fw-bold text-uppercase mb-3">
          Plataforma
        </h6>

        <ul class="list-unstyled mb-0">

          <li class="mb-2">
            <a
              href="/convocatorias"
              class="text-white-50 text-decoration-none">

              Convocatorias

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/empresas"
              class="text-white-50 text-decoration-none">

              Empresas

            </a>
          </li>

          <li>
            <a
              href="/publicar-convocatoria"
              class="text-white-50 text-decoration-none">

              Publicar convocatoria

            </a>
          </li>

        </ul>

      </div>


      <!-- Columna 3: Ayuda -->
      <div class="col-6 col-md-6 col-lg">

        <h6 class="fw-bold text-uppercase mb-3">
          Ayuda
        </h6>

        <ul class="list-unstyled mb-0">

          <li class="mb-2">
            <a
              href="/preguntas-frecuentes"
              class="text-white-50 text-decoration-none">

              Preguntas frecuentes

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/terminos"
              class="text-white-50 text-decoration-none">

              Términos del servicio

            </a>
          </li>

          <li>
            <a
              href="/privacidad"
              class="text-white-50 text-decoration-none">

              Privacidad de datos

            </a>
          </li>

        </ul>

      </div>


      <!-- Columna 4: Contacto -->
      <div class="col-12 col-md-6 col-lg">

        <h6 class="fw-bold text-uppercase mb-3">
          Contacto
        </h6>

        <ul class="list-unstyled text-white-50 mb-0">

          <li class="mb-2">
            <i class="fa-solid fa-envelope me-2 text-success"></i>

            <a
              href="mailto:practicas@ulima.edu.pe"
              class="text-white-50 text-decoration-none">

              practicas@ulima.edu.pe

            </a>
          </li>

          <li>
            <i class="fa-solid fa-location-dot me-2 text-success"></i>

            Av. Javier Prado Este 4600<br>
            <span class="ms-4">
              Sede Monterrico, Lima
            </span>

          </li>

        </ul>

      </div>


      <!-- Columna 5: Universidad de Lima -->
      <div class="col-12 col-md-6 col-lg">

        <h6 class="fw-bold text-uppercase mb-3">
          Universidad
        </h6>

        <a
          href="https://www.ulima.edu.pe/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white-50 text-decoration-none">

          <i class="fa-solid fa-arrow-up-right-from-square me-2 text-success"></i>
          Universidad de Lima

        </a>

      </div>

    </div>

  </div>


  <!-- Copyright -->
  <div class="border-top border-secondary">

    <div class="container py-3">

      <div class="text-center text-white-50 small">

        © <%= new Date().getFullYear() %> PrácticaLima.
        Todos los derechos reservados.

      </div>

    </div>

  </div>

</footer>


<!-- Footer hover styles -->
<style>

  footer a {
    transition: color 0.2s ease;
  }

  footer a:hover {
    color: #198754 !important;
  }

</style>
